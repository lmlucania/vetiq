                        "description": "1ページあたりの表示数（デフォルト50件）"
                    },
                    {
                        "name": "sort[]",
                        "in": "query",
                        "description": "並び替え",
                        "style": "deepObject",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "example": [
                                "last_name",
                                "-accept_appointment"
                            ]
                        }
                    },
                    {
                        "name": "keyword",
                        "in": "query",
