        "/hospital/menus": {
            "get": {
                "tags": [
                    "Hospital"
                ],
                "summary": "診察メニューの一覧",
                "operationId": "c456a36de2619e061663dc8aedbea58b",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "ページ番号"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "1ページあたりの表示数（デフォルト50件）"
                    },
                    {
                        "name": "sort[]",
                        "in": "query",
                        "description": "並び替え",
                        "style": "deepObject",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "example": [
                                "name",
                                "-detail"
                            ]
                        }
                    },
                    {
                        "name": "keyword",
                        "in": "query",
                        "description": "検索キーワード（メニュー名または説明の部分一致）"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Response~1Menu"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Hospital"
                ],
                "summary": "診察メニューの登録",
