    "components": {
        "schemas": {
            "Requests/Hospital/HospitalSaveRequest": {
                "description": "病院情報の保存",
                "required": [
                    "name",
                    "zipcode",
                    "address",
                    "phone",
                    "is_published"
                ],
                "properties": {
                    "name": {
                        "description": "病院名",
                        "type": "string",
                        "example": "テスト病院"
                    },
                    "zipcode": {
                        "description": "郵便番号 (7桁)",
                        "type": "string",
                        "example": 1234567
                    },
                    "address": {
                        "description": "住所",
                        "type": "string",
                        "example": "東京都新宿区西新宿2-8-1"
                    },
                    "phone": {
                        "description": "電話番号 (10または11桁)",
                        "type": "string",
                        "example": "0123456789"
                    },
                    "is_published": {
                        "description": "公開状態",
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Requests/Hospital/LoginRequest": {
                "description": "病院スタッフログイン",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "staff+1@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "Requests/Hospital/StoreMenuRequest": {
                "description": "診察メニューの登録",
                "required": [
                    "name",
                    "detail",
                    "required_time",
                    "is_published"
                ],
                "properties": {
                    "name": {
                        "description": "診察メニュー名",
                        "type": "string",
                        "example": "健康診断"
                    },
                    "detail": {
                        "description": "診察メニューの説明",
                        "type": "string",
                        "example": "年に一度の健康診断で、体調をチェックします。"
                    },
                    "required_time": {
                        "description": "所要時間（分単位）",
                        "type": "integer",
                        "maximum": 300,
                        "example": 30
                    },
                    "is_published": {
                        "description": "公開フラグ",
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "Requests/Hospital/StoreVetRequest": {
                "description": "獣医師の登録",
                "required": [
                    "last_name",
                    "first_name",
                    "accept_appointment",
                    "remark"
                ],
                "properties": {
                    "last_name": {
                        "description": "名前（姓）",
                        "type": "string",
                        "example": "山田"
                    },
                    "first_name": {
                        "description": "名前（名）",
                        "type": "string",
                        "example": "太郎"
                    },
                    "accept_appointment": {
                        "description": "指名予約可否フラグ",
                        "type": "boolean",
                        "example": true
                    },
                    "remark": {
                        "description": "備考",
                        "type": "string",
                        "example": "皮膚科専門医"
                    }
                },
                "type": "object"
            },
            "Requests/Hospital/UpdateMenuRequest": {
                "description": "診察メニューの更新",
                "required": [
                    "name",
                    "detail",
                    "required_time",
                    "is_published"
                ],
                "properties": {
                    "name": {
                        "description": "診察メニュー名",
                        "type": "string",
                        "example": "健康診断"
                    },
                    "detail": {
                        "description": "診察メニューの説明",
                        "type": "string",
                        "example": "年に一度の健康診断で、体調をチェックします。"
                    },
                    "required_time": {
                        "description": "所要時間（分単位）",
                        "type": "integer",
                        "maximum": 300,
                        "example": 30
                    },
                    "is_published": {
                        "description": "公開フラグ",
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "Requests/Hospital/UpdateVetRequest": {
                "description": "獣医師の更新",
                "required": [
                    "last_name",
                    "first_name",
                    "accept_appointment",
                    "remark"
                ],
                "properties": {
                    "last_name": {
                        "description": "名前（姓）",
                        "type": "string",
                        "example": "山田"
                    },
                    "first_name": {
                        "description": "名前（名）",
                        "type": "string",
                        "example": "太郎"
                    },
                    "accept_appointment": {
                        "description": "指名予約可否フラグ",
                        "type": "boolean",
                        "example": true
                    },
                    "remark": {
                        "description": "備考",
                        "type": "string",
                        "example": "皮膚科専門医"
                    }
                },
                "type": "object"
            },
            "Response/Hospital": {
                "description": "病院情報",
                "properties": {
                    "uuid": {
                        "description": "病院ID",
                        "type": "string",
                        "example": "e23c0dce-5d69-4572-a283-3643d69350bc"
                    },
                    "name": {
                        "description": "病院名",
                        "type": "string",
                        "example": "テスト病院"
                    },
                    "zipcode": {
                        "description": "郵便番号",
                        "type": "string",
                        "example": "1234567"
                    },
                    "address": {
                        "description": "住所",
                        "type": "string",
                        "example": "山梨県工藤市南区津田町加藤5-1-5"
                    },
                    "phone": {
                        "description": "電話番号",
                        "type": "string",
                        "example": "0123456789"
                    },
                    "is_published": {
                        "description": "公開フラグ",
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Response/Menu": {
                "description": "診察メニュー",
                "properties": {
                    "uuid": {
                        "description": "診察メニューID",
                        "type": "string",
                        "example": "1667cff9-71e5-4719-953c-e074507d2d3d"
                    },
                    "name": {
                        "description": "診察メニュー名",
                        "type": "string",
                        "example": "一般診察"
                    },
                    "detail": {
                        "description": "説明",
                        "type": "string",
                        "example": "基本的な診察を行います。健康状態のチェックや病気の早期発見をサポートします。"
                    },
                    "required_time": {
                        "description": "所要時間（分）",
                        "type": "string",
                        "example": "30"
                    },
                    "is_published": {
                        "description": "公開フラグ",
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Response/Vet": {
                "description": "獣医師",
                "properties": {
                    "uuid": {
                        "description": "獣医師UUID",
                        "type": "string",
                        "example": "5705d9e7-39bd-44c4-af36-be78d0eeb825"
                    },
                    "last_name": {
                        "description": "名前（姓）",
                        "type": "string",
                        "example": "山田"
                    },
                    "first_name": {
                        "description": "名前（名）",
                        "type": "string",
                        "example": "太郎"
                    },
                    "accept_appointment": {
                        "description": "指名予約可否フラグ",
                        "type": "boolean",
                        "example": true
                    },
                    "remark": {
                        "description": "備考",
                        "type": "string",
                        "example": "犬・猫の内科診療を得意としています。"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Hospital",
            "description": "病院スタッフ"
        }
    ]
}